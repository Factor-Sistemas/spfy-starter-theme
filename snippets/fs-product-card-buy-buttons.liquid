{%- if card_product.available -%}
  <product-card-buy
    variant-id="{{ card_product.selected_or_first_available_variant.id }}"
    class="absolute bottom-[130px] left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 pointer-events-none group-hover:pointer-events-auto transition-all duration-300 ease-out z-30 flex flex-col gap-2"
  >
    {%- if settings.comprar_ya_disponible -%}
      <button
        data-action="buy"
        class="relative w-full bg-neutral-950/95 hover:bg-neutral-900 text-white rounded-full py-2.5 text-[10px] font-bold uppercase tracking-widest shadow-md transition-all duration-300 flex items-center justify-center cursor-pointer border border-white/10 active:scale-98"
      >
        <span class="btn-label">Comprar ya</span>
        <span
          class="btn-spinner absolute opacity-0 scale-75 w-4 h-4 rounded-full border-2 border-white/20 border-t-white animate-spin"
        ></span>
      </button>
    {%- endif -%}
    {%- if settings.aniadir_carro_en_coleccion -%}
      <button
        data-action="add"
        class="relative w-full bg-white/95 hover:bg-neutral-50 text-neutral-900 rounded-full py-2.5 text-[10px] font-bold uppercase tracking-widest shadow-md transition-all duration-300 flex items-center justify-center cursor-pointer border border-neutral-200 active:scale-98"
      >
        <span class="btn-label">Añadir</span>
        <span
          class="btn-spinner absolute opacity-0 scale-75 w-4 h-4 rounded-full border-2 border-neutral-900/20 border-t-neutral-900 animate-spin"
        ></span>
      </button>
    {%- endif -%}
  </product-card-buy>
{%- endif -%}
