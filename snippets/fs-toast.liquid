{% comment %}
  Renderiza el contenedor global de notificaciones (Toaster) y el template HTML
  para que pueda ser maquetado y estilizado directamente en HTML/CSS/Tailwind.
{% endcomment %}

<fs-toaster class="fixed bottom-6 left-6 z-50 pointer-events-none flex flex-col gap-3" style="display: flex;">
  {% comment %}
    MOCKUP ESTATICO TEMPORAL ELIMINADO.
    El Toaster ahora funciona dinámicamente mediante el template de abajo.
  {% endcomment %}

  <!-- Template real que clona el JavaScript -->
  <template id="fs-toast-template">
    <div class="outer-toast-shell w-full p-1 bg-neutral-900/40 backdrop-blur-xl border border-white/10 rounded-2xl shadow-[0_12px_40px_rgba(0,0,0,0.3)] pointer-events-auto flex items-stretch transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] opacity-0 -translate-x-6 scale-95 [&.is-active]:opacity-100 [&.is-active]:translate-x-0 [&.is-active]:scale-100 will-change-all">
      <div class="inner-toast-core w-full bg-neutral-950/85 rounded-[calc(1rem-0.25rem)] px-4 py-3.5 flex items-start gap-3.5 border border-white/5">
        <div class="toast-icon-container flex-shrink-0 mt-0.5">
          <svg
            class="toast-icon-success hidden w-5 h-5 text-emerald-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <svg
            class="toast-icon-alert hidden w-5 h-5 text-rose-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
          <svg
            class="toast-icon-info hidden w-5 h-5 text-sky-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 1 1 1.085 1.085l-.04.04m-1.085 1.085.04-.02a.75.75 0 1 1 1.085 1.085l-.04.04M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>

        <div class="flex-1 min-w-0 flex flex-col gap-0.5">
          <h4 class="toast-title text-xs font-semibold !text-white tracking-wide"></h4>
          <p class="toast-message text-[12px] text-neutral-400 leading-relaxed"></p>
        </div>

        <button
          type="button"
          class="toast-close-btn flex-shrink-0 -mt-1 -mr-1.5 p-1 text-neutral-500 hover:text-neutral-300 active:scale-95 transition-all duration-300 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </template>
</fs-toaster>

<style>
  fs-toaster {
    display: flex !important;
  }
  .outer-toast-shell[data-type='success'] .toast-icon-success {
    display: block;
  }
  .outer-toast-shell[data-type='alert'] .toast-icon-alert {
    display: block;
  }
  .outer-toast-shell[data-type='info'] .toast-icon-info {
    display: block;
  }
</style>
