{% comment %}
  Renderiza la colección destacada en modo grid.
  Usa CSS grid con auto-fill para un layout responsive sin media queries.

  Acepta:
  - collection: {Object} Colección de Shopify (requerido).
  - products_to_show: {Number} Límite de productos a mostrar (requerido).
  - section_id: {String} ID de la sección (requerido).

  Uso:
  {% render 'fs-featured-collection-grid',
    collection: section.settings.collection,
    products_to_show: section.settings.products_to_show,
    section_id: section.id
  %}
{% endcomment %}

<ul
  class="grid product-grid contains-card contains-card--product grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-6"
  aria-label="{{ collection.title | escape }}"
>
  {% assign skip_card_product_styles = false %}

  {%- for product in collection.products limit: products_to_show -%}
    <li class="grid__item">
      {% render 'card-product',
        card_product: product,
        media_aspect_ratio: 'square',
        image_shape: 'default',
        lazy_load: false,
        show_secondary_image: false,
        show_vendor: false,
        show_rating: false,
        skip_styles: skip_card_product_styles,
        section_id: section_id,
        quick_add: 'none'
      %}
    </li>
    {%- assign skip_card_product_styles = true -%}
  {%- endfor -%}
</ul>
