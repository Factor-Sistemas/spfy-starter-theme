{% doc %}
  Renderiza el panel lateral de navegación principal (drawer) usando Alpine.js para controlar su visibilidad.
  Depende de la configuración de la sección padre (section.settings) y del objeto global de colecciones (collections).

  @example
  {% render 'fs-main-menu-drawer' %}
{% enddoc %}

<template x-teleport="body">
  <!-- Menú Lateral (Drawer) -->
  <div
    id="menu-drawer"
    class="fixed top-0 right-0 h-screen w-[450px] max-w-full bg-white/70 backdrop-blur-md lg:bg-white z-[999] p-6 shadow-2xl flex flex-col translate-x-full will-change-transform"
  >
    <div class="flex justify-end items-center mb-10">
      <button
        x-on:click="toggleMenu"
        class="p-2.5 text-neutral-500 hover:text-neutral-950 hover:bg-neutral-50 border border-neutral-100/60 rounded-full transition-all duration-300 cursor-pointer bg-neutral-50/50 active:scale-95 flex items-center justify-center"
        aria-label="Cerrar menú"
      >
        <!-- Icono de X ultra ligero -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="flex flex-col gap-1.5">
      <!-- Enlace Inicio Premium -->
      <a
        href="/"
        class="group flex items-center justify-between py-4 border-b border-neutral-100/60 text-xl font-medium tracking-tight text-neutral-900 hover:text-neutral-500 transition-colors"
      >
        <span>Inicio</span>
        <svg
          class="w-4 h-4 text-neutral-300 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </a>

      {%- if section.settings.mostrar_colecciones -%}
        <!-- Cabecera de Colecciones tipo Eyebrow -->
        <p class="text-[10px] uppercase tracking-[0.2em] font-semibold text-neutral-400 mt-6 mb-3">Colecciones</p>

        <div class="flex flex-col gap-1 pl-4 border-l border-neutral-100/80">
          {% paginate collections by 50 %}
            {% for collection in collections %}
              <a
                href="{{ collection.url }}"
                class="group/sub flex items-center justify-between py-2 text-[15px] font-medium tracking-tight text-neutral-600 hover:text-neutral-950 transition-colors"
              >
                <span>{{- collection.title -}}</span>
                <!-- Numeración a doble dígito ultra-fina -->
                <span class="text-[9px] font-mono text-neutral-300 group-hover/sub:text-neutral-500 transition-colors">
                  {{ forloop.index | prepend: '0' | slice: -2, 2 }}
                </span>
              </a>
            {% endfor %}
          {% endpaginate %}
        </div>
      {%- endif -%}
    </nav>
  </div>
</template>
