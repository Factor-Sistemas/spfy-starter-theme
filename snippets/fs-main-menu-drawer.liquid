{% doc %}
  Renderiza el panel lateral de navegación principal (drawer) usando Alpine.js para controlar su visibilidad.
  Depende de la configuración de la sección padre (section.settings) y del objeto global de colecciones (collections).

  @example
  {% render 'fs-main-menu-drawer' %}
{% enddoc %}

<template x-teleport="body">
  <!-- Menú Lateral (Drawer) -->
  <div
    id="menu-drawer"
    class="fixed top-0 right-0 h-screen w-[450px] max-w-full bg-white/70 backdrop-blur-md lg:bg-white z-[999] p-6 shadow-2xl flex flex-col translate-x-full will-change-transform"
  >
    <div class="flex justify-between items-center mb-8">
      <h3 class="text-xl font-bold">Menú</h3>
      <button
        x-on:click="toggleMenu"
        class="p-2 hover:bg-neutral-800 hover:text-white rounded-full transition-colors cursor-pointer bg-neutral-100"
        aria-label="Cerrar menú"
      >
        <!-- Icono de X simple con SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="flex flex-col gap-4 text-lg text-neutral-800">
      <a href="/" class="hover:text-amber-500 transition-colors">Inicio</a>
      {%- if section.settings.mostrar_colecciones -%}
        <p>Colecciones</p>
        <div class="flex flex-col gap-2 pl-4 border-l border-neutral-200 text-base">
          {% paginate collections by 50 %}
            {% for collection in collections %}
              <a href="{{ collection.url }}" class="hover:text-amber-500 transition-colors text-neutral-600">
                {{- collection.title -}}
              </a>
            {% endfor %}
          {% endpaginate %}
        </div>
      {%- endif -%}
    </nav>
  </div>
</template>
