{% comment %}
  Renderiza el pie de página del cajón del carrito, que contiene los totales y las acciones de pago.
  Acepta:
  - cart: El objeto del carrito de Shopify.
{% endcomment %}

<div class="border-t border-neutral-100 p-6 bg-white space-y-4">
  <!-- Fila de subtotal -->
  <div class="flex justify-between items-center text-neutral-900">
    <span class="text-sm font-medium text-neutral-500">Subtotal</span>
    <span class="text-xl font-bold tracking-tight">{{ cart.total_price | money_with_currency }}</span>
  </div>

  {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
    <p class="text-xs text-neutral-400 text-left">
      {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
        Impuestos incluidos. Envío calculado al finalizar pedido.
      {%- elsif cart.taxes_included -%}
        Impuestos incluidos.
      {%- elsif shop.shipping_policy.body != blank -%}
        Envío calculado al finalizar pedido.
      {%- endif -%}
    </p>
  {%- endif -%}

  <!-- Botón de finalizar compra (Arquitectura Nested CTA / Button-in-Button) -->
  <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
    <button 
      type="submit" 
      name="checkout" 
      class="group w-full flex items-center justify-between bg-neutral-950 text-white font-semibold rounded-full p-1.5 transition-all duration-300 hover:bg-neutral-900 active:scale-[0.98] cursor-pointer"
    >
      <span class="pl-6 text-sm tracking-wide">Proceder al pago</span>
      <!-- Icono circular anidado -->
      <span class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center transition-all duration-300 group-hover:bg-white/20 group-hover:translate-x-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </span>
    </button>
  </form>
</div>
