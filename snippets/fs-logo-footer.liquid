{%- case dim -%}
  {%- when 'xs' -%}
    {%- assign cls = 'size-8' -%}
    {%- assign w = '32px' -%}
    {%- assign h = '32px' -%}
  {%- when 'sm' -%}
    {%- assign cls = 'size-10' -%}
    {%- assign w = '40px' -%}
    {%- assign h = '40px' -%}
  {%- when 'md' -%}
    {%- assign cls = 'size-12' -%}
    {%- assign w = '48px' -%}
    {%- assign h = '48px' -%}
  {%- when 'lg' -%}
    {%- assign cls = 'size-16' -%}
    {%- assign w = '64px' -%}
    {%- assign h = '64px' -%}
  {%- when 'xl' -%}
    {%- assign cls = 'size-20' -%}
    {%- assign w = '80px' -%}
    {%- assign h = '80px' -%}
  {%- when '2xl' -%}
    {%- assign cls = 'size-24' -%}
    {%- assign w = '96px' -%}
    {%- assign h = '96px' -%}
  {%- when '3xl' -%}
    {%- assign cls = 'size-32' -%}
    {%- assign w = '128px' -%}
    {%- assign h = '128px' -%}
  {%- else -%}
    {%- assign cls = 'size-12' -%}
    {%- assign w = '48px' -%}
    {%- assign h = '48px' -%}
{%- endcase -%}

<div class="{{ cls }}">
  <svg
    fill="#000000"
    width="{{ w }}"
    height="{{ h }}"
    viewBox="0 0 32 32"
    id="icon"
    xmlns="http://www.w3.org/2000/svg"
  >
