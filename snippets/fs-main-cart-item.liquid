{% doc %}
  Renderiza un artículo individual dentro del carrito deslizable lateral.

  @param {object} item - El objeto de línea de artículo (line item) de Shopify.
  @param {number} index - El índice en base 1 dentro del bucle del carrito (forloop.index).

  @example
  {% render 'fs-main-cart-item', item: item, index: forloop.index %}
{% enddoc %}

<div class="bg-white/50 shadow-xs group transition-all duration-300 p-3 rounded-md">
  <div class="space-y-1 min-w-0 flex justify-between mb-3">
    <p class="text-base font-medium text-neutral-900 leading-snug tracking-tight truncate">
      <a href="{{ item.url }}" class="hover:text-amber-600 transition-colors duration-300 decoration-none">
        {{- item.product.title -}}
      </a>
    </p>
    {%- if item.product.has_only_default_variant == false -%}
      <span class="inline-block text-[10px] font-semibold tracking-wider text-neutral-400 uppercase bg-neutral-50 px-2 py-0.5 rounded border border-neutral-100">
        {{ item.variant.title }}
      </span>
    {%- endif -%}
  </div>
  <div class="grid grid-cols-6">
    <div class="col-span-2">
      {%- render 'fs-main-cart-item-image', item: item -%}
    </div>
    <div class="col-span-4">
      {%- render 'fs-main-cart-item-price', item: item -%}
      {%- render 'fs-main-cart-item-quantity', item: item, index: index -%}
    </div>
  </div>
</div>
