<div class="overflow-y-auto px-6 py-6 space-y-5 scrollbar-thin scrollbar-thumb-neutral-200">
  {%- if cart == empty -%}
    {%- render 'fs-main-cart-empty' -%}
  {%- else -%}
    {%- for item in cart.items -%}
      {%- render 'fs-main-cart-item', item: item, index: forloop.index -%}
    {%- endfor -%}
  {%- endif -%}
</div>
