{% doc %}
  Renderiza el precio formateado de un artículo individual del carrito.

  @param {object} item - El objeto de línea de artículo (line item) de Shopify.

  @example
  {% render 'fs-main-cart-item-price', item: item %}
{% enddoc %}

<div class="flex justify-end items-start gap-3">
  <!-- Precio -->
  <p class="text-sm font-semibold text-neutral-900 tracking-tight flex-shrink-0">
    {{ item.final_line_price | money }}
  </p>
</div>
