{%- comment -%}
  =============================================================================
  PRODUCT SPECIFICATIONS
  =============================================================================
  Renderiza especificaciones técnicas usando metafields individuales.
  Cada especificación es un campo plano alimentado por el CRM de Madrid.

  Configuración en Shopify Admin:
  Settings → Custom data → Products → Add definition
  - Type: Single line text
  - Key: custom.{nombre_especificacion}

  Ejemplo de metafields:
  - custom.spec_box_material
  - custom.spec_bezel_exterior
  - custom.spec_dial
  - custom.spec_movement
  - custom.spec_water_resistance
  - custom.spec_dimensions
  - custom.spec_case
  - custom.spec_crown_pushers
  - custom.spec_crystal
  - custom.spec_strap
  - custom.spec_engravings
  - custom.spec_complexities
  - custom.spec_includes
{%- endcomment -%}
{%- assign custom = product.metafields.custom -%}

{%- capture specs_output -%}
  {%- assign caja = custom.espec_caja | default: custom.spec_box_material | default: custom.caja -%}
  {%- if caja != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Caja:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ caja }}</span>
    </div>
  {%- endif -%}

  {%- assign bezel_ext = custom.espec_bisel_exterior | default: custom.spec_bezel_exterior -%}
  {%- if bezel_ext != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Bisel exterior:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ bezel_ext }}</span>
    </div>
  {%- endif -%}

  {%- assign bezel_int = custom.espec_bisel_interior | default: custom.spec_bezel_interior -%}
  {%- if bezel_int != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Bisel interior:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ bezel_int }}</span>
    </div>
  {%- endif -%}

  {%- assign dial = custom.espec_dial | default: custom.spec_dial -%}
  {%- if dial != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Dial:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ dial }}</span>
    </div>
  {%- endif -%}

  {%- assign hands = custom.espec_agujas | default: custom.spec_hands_indexes -%}
  {%- if hands != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Agujas e indexes:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ hands }}</span>
    </div>
  {%- endif -%}

  {%- assign complexities = custom.espec_complicaciones | default: custom.spec_complexities -%}
  {%- if complexities != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Complicaciones:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ complexities }}</span>
    </div>
  {%- endif -%}

  {%- assign crown = custom.espec_corona | default: custom.spec_crown_pushers -%}
  {%- if crown != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Corona y pulsadores:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ crown }}</span>
    </div>
  {%- endif -%}

  {%- assign crystal = custom.espec_cristal | default: custom.spec_crystal -%}
  {%- if crystal != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Cristal:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ crystal }}</span>
    </div>
  {%- endif -%}

  {%- assign strap = custom.espec_correa | default: custom.spec_strap -%}
  {%- if strap != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Correa:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ strap }}</span>
    </div>
  {%- endif -%}

  {%- assign engravings = custom.espec_grabados | default: custom.spec_engravings -%}
  {%- if engravings != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Grabados:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ engravings }}</span>
    </div>
  {%- endif -%}

  {%- assign movement = custom.espec_movimiento | default: custom.spec_movement -%}
  {%- if movement != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Mecanismo:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ movement }}</span>
    </div>
  {%- endif -%}

  {%- assign water = custom.espec_resistencia_agua | default: custom.spec_water_resistance -%}
  {%- if water != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Resistencia al agua:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ water }}</span>
    </div>
  {%- endif -%}

  {%- assign dimensions = custom.espec_medidas | default: custom.spec_dimensions -%}
  {%- if dimensions != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Medidas:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ dimensions }}</span>
    </div>
  {%- endif -%}

  {%- assign includes = custom.espec_incluye | default: custom.spec_includes -%}
  {%- if includes != blank -%}
    <div class="spec-row flex flex-col sm:flex-row sm:items-start py-3 border-b border-gray-100 last:border-0">
      <span class="spec-label w-36 shrink-0 text-xs font-bold uppercase tracking-wider text-gray-900">Incluye:</span>
      <span class="spec-value text-sm text-gray-700 sm:ml-4">{{ includes }}</span>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- if specs_output != blank -%}
  <div class="space-y-0">
    {{ specs_output }}
  </div>
{%- endif -%}
