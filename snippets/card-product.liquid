{% comment %}
  Renderiza la tarjeta de un producto.

  Acepta: - card_product: {Object} Objeto de producto de Shopify (opcional). - media_aspect_ratio: {String} Relación de
  aspecto de la imagen. Valores: "square", "portrait", "adapt". Por defecto es "square" (opcional). -
  show_secondary_image: {Boolean} Muestra la imagen secundaria al pasar el cursor. Por defecto: false (opcional). -
  show_vendor: {Boolean} Muestra el proveedor del producto. Por defecto: false. - show_rating: {Boolean} Muestra la
  valoración del producto. Por defecto: false. - lazy_load: {Boolean} Si la imagen debe cargarse de forma diferida. Por
  defecto: true (opcional). - section_id: {String} El ID de la sección que contiene esta tarjeta. - placeholder_image:
  {String} La imagen de marcador de posición cuando no hay producto. Por defecto: 'product-apparel-2' (opcional).

  Uso:
  {% render 'card-product', show_vendor: section.settings.show_vendor %}
{% endcomment %}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign ratio = 1
    if card_product.featured_media and media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    elsif card_product.featured_media and media_aspect_ratio == 'adapt'
      assign ratio = card_product.featured_media.aspect_ratio
    endif
    if ratio == 0 or ratio == null
      assign ratio = 1
    endif
  -%}

  <div class="group relative bg-neutral-50/50 p-2 rounded-[2rem]">
    {% comment %} Contenedor interno (Doble bisel / Núcleo concéntrico) {% endcomment %}
    <div class="relative bg-white rounded-[calc(2rem-0.5rem)] overflow-hidden border-0 border-red-700 flex flex-col flex-1">
      {% comment %} Etiquetas / Badges {% endcomment %}
      {%- render 'fs-product-card-badget', card_product: card_product -%}
      {% comment %} Área de imagen {% endcomment %}
      {%- render 'fs-product-card-media', card_product: card_product -%}

      {% comment %} Botones de acción rápida en hover {% endcomment %}
      <product-card-buy 
        variant-id="{{ card_product.selected_or_first_available_variant.id }}" 
        class="absolute bottom-[130px] left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 pointer-events-none group-hover:pointer-events-auto transition-all duration-300 ease-out z-30 flex flex-col gap-2"
      >
        <button data-action="buy" class="relative w-full bg-neutral-950/95 hover:bg-neutral-900 text-white rounded-full py-2.5 text-[10px] font-bold uppercase tracking-widest shadow-md transition-all duration-300 flex items-center justify-center cursor-pointer border border-white/10 active:scale-98">
          <span class="btn-label">Comprar ya</span>
          <span class="btn-spinner absolute opacity-0 scale-75 w-4 h-4 rounded-full border-2 border-white/20 border-t-white animate-spin"></span>
        </button>
        <button data-action="add" class="relative w-full bg-white/95 hover:bg-neutral-50 text-neutral-900 rounded-full py-2.5 text-[10px] font-bold uppercase tracking-widest shadow-md transition-all duration-300 flex items-center justify-center cursor-pointer border border-neutral-200 active:scale-98">
          <span class="btn-label">Añadir</span>
          <span class="btn-spinner absolute opacity-0 scale-75 w-4 h-4 rounded-full border-2 border-neutral-900/20 border-t-neutral-900 animate-spin"></span>
        </button>
      </product-card-buy>

      {% comment %} Área de información {% endcomment %}
      <div class="p-5 flex flex-col flex-1 justify-between gap-y-4 bg-white">
        {%- render 'fs-product-card-title-vendor', card_product: card_product -%}

        {% comment %} Precio y compra rápida {% endcomment %}
        <div class="flex items-center justify-between mt-1 pt-3 border-t border-neutral-50">
          {%- render 'fs-product-card-price', card_product: %card_product -%}
          {% comment %} Flecha de acción (Patrón de icono en el botón) {% endcomment %}
          <a
            href="{{ card_product.url }}"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  {%- render 'fs-product-card-placeholder' -%}
{%- endif -%}
