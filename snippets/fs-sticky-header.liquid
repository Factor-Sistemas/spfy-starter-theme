<fs-sticky-header
  id="main-header"
  class="fixed top-0 left-0 w-full h-20 z-50 bg-white/30 transition-transform duration-300 ease-out backdrop-blur-md"
>
  <div class="flex h-full items-center justify-between px-4 md:px-6">
    {%- if settings.sticky_header_logo != blank -%}
      <img
        src="{{ settings.sticky_header_logo | image_url: width: settings.sticky_header_logo_width }}"
        width="{{ settings.sticky_header_logo_width }}"
        height="{{ settings.sticky_header_logo.height }}"
        alt="{{ shop.name }}"
        class="h-auto max-h-14"
      >
    {%- else -%}
      <p class="text-lg font-bold text-blue-900">{{ shop.name }}</p>
    {%- endif -%}
    
    <div class="w-10"></div>
  </div>

  <script>
    class FsStickyHeader extends HTMLElement {
      constructor() {
        super();
        this.threshold = 300;
        this._handleScroll = this._handleScroll.bind(this);
      }

      connectedCallback() {
        window.addEventListener('scroll', this._handleScroll, { passive: true });
        this._handleScroll();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this._handleScroll);
      }

      _handleScroll() {
        if (window.scrollY > this.threshold) {
          this.style.transform = 'translateY(-100%)';
        } else {
          this.style.transform = 'translateY(0)';
        }
      }
    }

    if (!customElements.get('fs-sticky-header')) {
      customElements.define('fs-sticky-header', FsStickyHeader);
    }
  </script>
</fs-sticky-header>
