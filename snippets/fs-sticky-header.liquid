{%- assign header_height = 'h-24' -%}
{%- if settings.sticky_header_height == 'h-28' -%}
  {%- assign header_height = 'h-28' -%}
{%- elsif settings.sticky_header_height == 'h-32' -%}
  {%- assign header_height = 'h-32' -%}
{%- elsif settings.sticky_header_height == 'h-36' -%}
  {%- assign header_height = 'h-36' -%}
{%- endif -%}

{%- assign align_mobile = 'justify-center' -%}
{%- if settings.sticky_header_align_mobile == 'justify-start' -%}
  {%- assign align_mobile = 'justify-start' -%}
{%- endif -%}

{%- assign align_desktop = 'md:justify-start' -%}
{%- if settings.sticky_header_align_desktop == 'md:justify-center' -%}
  {%- assign align_desktop = 'md:justify-center' -%}
{%- endif -%}

<fs-sticky-header
  id="main-header"
  class="fixed top-0 left-0 w-full z-50 bg-white/30 transition-transform duration-300 ease-out backdrop-blur-md {{ header_height }}"
>
  <div class="flex {{ header_height }} items-center px-4 md:px-6 {{ align_mobile }} {{ align_desktop }}">
    {%- if settings.sticky_header_logo != blank -%}
      <img
        src="{{ settings.sticky_header_logo | image_url: width: 200 }}"
        width="{{ settings.sticky_header_logo.width }}"
        height="{{ settings.sticky_header_logo.height }}"
        alt="{{ shop.name }}"
        class="m-0 py-4 h-full w-auto"
      >
    {%- else -%}
      <p class="text-lg font-bold text-blue-900">{{ shop.name }}</p>
    {%- endif -%}
  </div>

  <script>
    class FsStickyHeader extends HTMLElement {
      constructor() {
        super();
        this.threshold = 300;
        this._handleScroll = this._handleScroll.bind(this);
      }

      connectedCallback() {
        window.addEventListener('scroll', this._handleScroll, { passive: true });
        this._handleScroll();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this._handleScroll);
      }

      _handleScroll() {
        if (window.scrollY > this.threshold) {
          this.style.transform = 'translateY(-100%)';
        } else {
          this.style.transform = 'translateY(0)';
        }
      }
    }

    if (!customElements.get('fs-sticky-header')) {
      customElements.define('fs-sticky-header', FsStickyHeader);
    }
  </script>
</fs-sticky-header>
