<footer class="px-6 py-12 md:px-16 lg:px-24 xl:px-32 w-full text-gray-500 bg-gray-100">
  <div class="flex flex-col md:flex-row justify-between w-full gap-10 border-b border-gray-200 pb-6">
    <!-- Columna Marca -->
    <div class="md:max-w-96">
      {%- if settings.footer_logo != blank -%}
        <img
          src="{{ settings.footer_logo | image_url: width: settings.footer_logo_width }}"
          width="{{ settings.footer_logo_width }}"
          height="{{ settings.footer_logo.width }}"
          loading="lazy"
          alt="{{ shop.name }}"
          class="h-auto"
        >
      {%- else -%}
        <p class="text-2xl font-bold text-gray-900">{{ shop.name }}</p>
      {%- endif -%}

      {%- if settings.footer_brand_description != blank -%}
        <p class="mt-6 text-sm">{{ settings.footer_brand_description }}</p>
      {%- endif -%}
    </div>

    <!-- Columna Derecha: Menú + Contacto -->
    <div class="flex-1 flex flex-col md:flex-row items-start md:justify-end gap-12 md:gap-20">
      
      <!-- Menú Corporativo -->
      <div>
        <p class="font-semibold text-gray-900 mb-5 text-2xl">Información corporativa</p>
        <ul class="space-y-2">
          {% for link in linklists['men-info-corporativa'].links %}
            <li>
              <a href="{{ link.url }}" class="hover:text-gray-900 transition-colors">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- Bloque Contáctanos -->
      <div>
        <p class="font-semibold text-gray-900 mb-5 text-2xl">Contáctanos</p>
        <div class="space-y-5">
          
          {%- if settings.footer_email_link != blank -%}
            <div class="flex items-start gap-3">
              {%- if settings.footer_email_icon != blank -%}
                <img src="{{ settings.footer_email_icon | image_url: width: 24 }}" width="24" height="24" alt="" class="mt-0.5 w-6 h-6">
              {%- endif -%}
              <div>
                <p class="font-medium text-gray-900">{{ settings.footer_email_title | default: 'Email' }}</p>
                <a href="mailto:{{ settings.footer_email_link }}" class="hover:text-gray-900">{{ settings.footer_email_link }}</a>
              </div>
            </div>
          {%- endif -%}

          {%- if settings.footer_phone_link != blank -%}
            <div class="flex items-start gap-3">
              {%- if settings.footer_phone_icon != blank -%}
                <img src="{{ settings.footer_phone_icon | image_url: width: 24 }}" width="24" height="24" alt="" class="mt-0.5 w-6 h-6">
              {%- endif -%}
              <div>
                <p class="font-medium text-gray-900">{{ settings.footer_phone_title | default: 'Teléfono' }}</p>
                <a href="tel:{{ settings.footer_phone_link }}" class="hover:text-gray-900">{{ settings.footer_phone_link }}</a>
              </div>
            </div>
          {%- endif -%}

          {%- if settings.footer_schedule_text != blank -%}
            <div class="flex items-start gap-3">
              {%- if settings.footer_schedule_icon != blank -%}
                <img src="{{ settings.footer_schedule_icon | image_url: width: 24 }}" width="24" height="24" alt="" class="mt-0.5 w-6 h-6">
              {%- endif -%}
              <div>
                <p class="font-medium text-gray-900">{{ settings.footer_schedule_title | default: 'Horario' }}</p>
                <p class="text-sm">{{ settings.footer_schedule_text }}</p>
              </div>
            </div>
          {%- endif -%}

        </div>
      </div>

    </div>
  </div>

  <!-- Barra inferior -->
  <div class="flex flex-col md:flex-row justify-between items-center pt-4 text-xs md:text-sm">
    <p class="pb-4 md:pb-0">&copy; {{ 'now' | date: '%Y' }} {{ settings.frase_copyright | default: shop.name }}</p>
    <div class="flex items-center gap-4">
      {%- render 'payment-icons' -%}
    </div>
  </div>
</footer>
