<!-- Capa Translúcida para Móvil -->
<div
  id="menu-overlay"
  class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none z-[998] transition-opacity duration-300"
  @click="toggle"
></div>

<!-- Menú Lateral (Drawer) -->

<div class="w-full bg-red-400 fixed top-0 flex justify-end">
  <button
    @click="toggle"
    class="header__icon header__icon--menu p-2 text-neutral-900 cursor-pointer"
    aria-label="Menú"
  >
    {{- 'icon-hamburger.svg' | inline_asset_content -}}
  </button>
</div>
<div
  id="menu-drawer"
  class="fixed top-0 right-0 h-screen bg-white z-[999] p-6 shadow-2xl flex flex-col will-change-transform"
>
  <div class="flex justify-between items-center mb-8">
    <h3 class="text-xl font-bold">Menú</h3>
    <button
      @click="toggle"
      class="p-2 hover:bg-neutral-800 rounded-full transition-colors cursor-pointer"
      aria-label="Cerrar menú"
    >
      <!-- Icono de X simple con SVG -->
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="flex flex-col gap-4 text-lg">
    <a href="/" class="hover:text-amber-500 transition-colors">Inicio</a>
    <a href="/collections" class="hover:text-amber-500 transition-colors">Colecciones</a>
    <a href="/products" class="hover:text-amber-500 transition-colors">Productos</a>
  </nav>
</div>
