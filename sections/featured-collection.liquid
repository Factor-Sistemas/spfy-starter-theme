{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'fs-featured-collection-slider.css' | asset_url | stylesheet_tag }}

<div class="bg-white text-neutral-900 py-16 md:py-24 isolate border-t border-neutral-100">
  <div
    class="collection max-w-9xl mx-auto px-6 md:px-12"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
  >
    {%- assign collection_handle = section.settings.collection -%}
    {%- assign products_to_show = section.settings.products_to_show -%}
    {%- assign modo = section.settings.modo_visualizacion_productos -%}
    {%- assign slider_id = 'fs-featured-collection-slider-' | append: section.id -%}

    {%- if modo == 'slider' -%}
      <div class="flex justify-between items-end mb-8">
        <div class="space-y-2">
          {%- if section.settings.bagdet_destacar -%}
            <span class="inline-block px-3 py-1 text-[9px] uppercase tracking-[0.2em] font-bold text-neutral-400 bg-neutral-50 rounded-full border border-neutral-100/80">
              {{ section.settings.bagdet_text }}
            </span>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-neutral-900">
              {{ section.settings.title }}
            </h2>
          {%- endif -%}
          {%- if section.settings.description != blank
            or section.settings.show_description
            and section.settings.collection.description != empty
          -%}
            <div class="text-neutral-500 text-sm max-w-md leading-relaxed mt-2">
              {%- if section.settings.show_description -%}
                {{ section.settings.collection.description }}
              {%- else -%}
                {{ section.settings.description -}}
              {%- endif %}
            </div>
          {%- endif -%}
        </div>

        {%- if collection_handle.products_count > products_to_show -%}
          <div class="fs-slider-nav flex-shrink-0 ml-4">
            <div class="swiper-button-prev swiper-nav-prev-{{ slider_id }}"></div>
            <div class="swiper-button-next swiper-nav-next-{{ slider_id }}"></div>
          </div>
        {%- endif -%}
      </div>
      {% render 'fs-featured-collection-slider',
        collection: collection_handle,
        products_to_show: products_to_show,
        section_id: section.id
      %}
    {%- else -%}
      <div class="collection__title mb-12 text-center md:text-left space-y-2">
        {%- if section.settings.bagdet_destacar -%}
          <span class="inline-block px-3 py-1 text-[9px] uppercase tracking-[0.2em] font-bold text-neutral-400 bg-neutral-50 rounded-full border border-neutral-100/80">
            {{ section.settings.bagdet_text }}
          </span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-neutral-900">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank
          or section.settings.show_description
          and section.settings.collection.description != empty
        -%}
          <div class="text-neutral-500 text-sm max-w-md leading-relaxed mt-2">
            {%- if section.settings.show_description -%}
              {{ section.settings.collection.description }}
            {%- else -%}
              {{ section.settings.description -}}
            {%- endif %}
          </div>
        {%- endif -%}
      </div>
      {% render 'fs-featured-collection-grid',
        collection: collection_handle,
        products_to_show: products_to_show,
        section_id: section.id
      %}
    {%- endif -%}
  </div>
</div>

{% render 'seo-schema', section: section %}

{% schema %}
{
  "name": "Colección destacada",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "select",
      "id": "modo_visualizacion_productos",
      "label": "Modo visualización productos",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ]
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 4,
      "label": "Nº Productos a mostrar"
    },
    {
      "type": "header",
      "content": "Texto"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Destacados",
      "label": "Título"
    },
    {
      "type": "checkbox",
      "id": "bagdet_destacar",
      "default": true,
      "label": "Texto tag destacar"
    },
    {
      "type": "text",
      "id": "bagdet_text",
      "default": "Novedades",
      "label": "Texto tag"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Pequeño"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        },
        {
          "value": "hxl",
          "label": "Extra grande"
        },
        {
          "value": "hxxl",
          "label": "Superextragrande"
        }
      ],
      "default": "h1",
      "label": "Tamaño del título"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostrar descripción de la colección desde el panel de control",
      "default": false
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "Estilo de descripción",
      "options": [
        {
          "value": "body",
          "label": "Cuerpo"
        },
        {
          "value": "subtitle",
          "label": "Subtítulo"
        },
        {
          "value": "uppercase",
          "label": "Mayúscula"
        }
      ],
      "default": "body"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Botón \"Ver todo\"",
      "info": "Visible si la colección tiene más productos que los que se muestran"
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "Estilo \"Ver todos\"",
      "options": [
        {
          "value": "link",
          "label": "Enlace"
        },
        {
          "value": "outline",
          "label": "Botón con contorno"
        },
        {
          "value": "solid",
          "label": "Botón sólido"
        }
      ],
      "default": "solid"
    }
  ],
  "presets": [
    {
      "name": "Colección destacada"
    }
  ]
}
{% endschema %}
