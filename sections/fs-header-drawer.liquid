<div
  class="w-full fixed bg-white/30 backdrop-blur-md top-0 flex justify-end p-4 transition-opacity duration-300 h-18 z-[888] gap-x-5"
  id="menu-accions"
>
  {%- if section.settings.mostrar_carrito -%}
    <button
      class="p-2 text-neutral-900 cursor-pointer block relative"
      aria-label="Cart"
    >
      {%- render 'icons', name: 'shopping-cart', class: 'size-5 stroke-black' -%}
      {%- if cart != empty -%}
        <div class="absolute -right-1 top-0 bg-black rounded-full text-white size-5 text-[12px]">
          {%- if cart.item_count < 100 -%}
            <span aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
          <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
        </div>
      {%- endif -%}
    </button>
  {%- endif -%}
  <button
    @click="toggle"
    class="p-2 text-neutral-900 cursor-pointer block"
    aria-label="Menú"
  >
    {%- render 'icons', name: 'menu', class: 'size-5 stroke-black' -%}
  </button>
</div>

<template x-teleport="body">
  <!-- Capa Translúcida para Móvil -->
  <div
    id="menu-overlay"
    class="fixed inset-0 bg-black/50 opacity-10 pointer-events-none z-[998] transition-opacity duration-300"
    @click="toggle"
  ></div>
</template>

<template x-teleport="body">
  <!-- Menú Lateral (Drawer) -->
  <div
    id="menu-drawer"
    class="fixed top-0 right-0 h-screen w-[350px] bg-white z-[999] p-6 shadow-2xl flex flex-col translate-x-full will-change-transform"
  >
    <div class="flex justify-between items-center mb-8">
      <h3 class="text-xl font-bold">Menú</h3>
      <button
        @click="toggle"
        class="p-2 hover:bg-neutral-800 hover:text-white rounded-full transition-colors cursor-pointer bg-neutral-100"
        aria-label="Cerrar menú"
      >
        <!-- Icono de X simple con SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="flex flex-col gap-4 text-lg text-neutral-800">
      <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
      {%- if section.settings.mostrar_colecciones -%}
        {% for collection in collections %}
          <a href="{{ collection.url }}" class="hover:text-amber-500 transition-colors text-neutral-600">
            {{- collection.title -}}
          </a>
        {% endfor %}
      {%- else -%}
        <a href="/collections">Ver familias</a>
      {%- endif -%}
    </nav>
  </div>
</template>
{% schema %}
{
  "name": "fs-header-drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "mostrar_colecciones",
      "label": "Mostrar colecciones",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mostrar_carrito",
      "label": "Carrito Compra",
      "default": true
    }
  ]
}
{% endschema %}
