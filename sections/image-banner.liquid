{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
  assign half_width = '50vw'
  assign stacked_sizes = '(min-width: 750px) 50vw, 100vw'
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div
  id="Banner-{{ section.id }}"
  class="relative flex flex-col md:flex-row isolate overflow-hidden
    md:min-h-[56rem]
    after:content-[''] after:absolute after:inset-0 after:bg-black after:z-[1] after:opacity-30
    {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- if section.settings.image != blank -%}
    <div class="{% if section.settings.image_2 != blank %}max-md:relative max-md:w-full{% endif %} md:absolute md:inset-0 md:w-full md:h-full{% if section.settings.image_2 != blank %} md:w-1/2{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
        if section.settings.image_2 != blank
          assign sizes = stacked_sizes
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          class: 'max-md:w-full max-md:h-auto md:w-full md:h-full md:object-cover',
          sizes: sizes,
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- elsif section.settings.image_2 == blank -%}
    <div class="md:absolute md:inset-0 md:w-full md:h-full{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg max-md:w-full max-md:h-auto md:w-full md:h-full' }}
    </div>
  {%- endif -%}
  {%- if section.settings.image_2 != blank -%}
    <div class="max-md:relative max-md:w-full md:absolute md:inset-0 md:w-1/2 md:left-auto md:right-0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height_2 = section.settings.image_2.width | divided_by: section.settings.image_2.aspect_ratio
        if section.settings.image != blank
          assign sizes = stacked_sizes
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image_2
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_2.width,
          height: image_height_2,
          class: 'max-md:w-full max-md:h-auto md:w-full md:h-full md:object-cover',
          sizes: sizes,
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- endif -%}
  <div class="relative z-[2] flex items-center justify-center w-full p-0 max-w-[var(--page-width)] mx-auto px-4 md:px-20{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="relative z-10 w-full text-center p-8 md:p-14 max-w-[71rem] md:min-w-[45rem] bg-surface-card border border-hairline rounded-lg">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2
              class="mt-0 mb-0 {% case block.settings.heading_size %}{% when 'h2' %}text-title-lg{% when 'h1' %}text-display-sm{% when 'h0' %}text-display-md{% when 'hxl' %}text-display-lg{% when 'hxxl' %}text-display-xl{% endcase %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.heading }}
            </h2>
          {%- when 'text' -%}
            <div class="mt-4 {% case block.settings.text_style %}{% when 'subtitle' %}text-title-md{% when 'caption-with-letter-spacing' %}text-caption-uppercase{% else %}text-body-md{% endcase %}" {{ block.shopify_attributes }}>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- when 'buttons' -%}
            <div
              class="inline-flex flex-wrap gap-4 max-w-[45rem] break-words mt-6{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} [&>*]:grow [&>*]:min-w-[22rem]{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="inline-flex items-center justify-center px-5 py-3 h-11 min-w-[calc(12rem+2px)] no-underline cursor-pointer text-button font-button leading-none rounded-md{% if block.settings.button_style_secondary_1 %} bg-canvas text-ink border border-hairline{% else %} bg-primary text-on-primary{% endif %}"
                >
                  {{- block.settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="inline-flex items-center justify-center px-5 py-3 h-11 min-w-[calc(12rem+2px)] no-underline cursor-pointer text-button font-button leading-none rounded-md{% if block.settings.button_style_secondary_2 %} bg-canvas text-ink border border-hairline{% else %} bg-primary text-on-primary{% endif %}"
                >
                  {{- block.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Banner de imagen",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Imagen 2"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Banner de imagen",
          "label": "Título"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "Pequeño"
            },
            {
              "value": "h1",
              "label": "Mediano"
            },
            {
              "value": "h0",
              "label": "Grande"
            },
            {
              "value": "hxl",
              "label": "Extra grande"
            },
            {
              "value": "hxxl",
              "label": "Superextragrande"
            }
          ],
          "default": "h1",
          "label": "Tamaño del título"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Ofrece a los clientes información sobre las imágenes del banner o el contenido de la plantilla.",
          "label": "Texto"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "Cuerpo"
            },
            {
              "value": "subtitle",
              "label": "Subtítulo"
            },
            {
              "value": "caption-with-letter-spacing",
              "label": "Mayúscula"
            }
          ],
          "default": "body",
          "label": "Estilo"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Botones",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Botón 1"
        },
        {
          "type": "text",
          "id": "button_label_1",
          "default": "Etiqueta de botón",
          "label": "Etiqueta",
          "info": "Dejar en blanco para ocultar"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Enlace"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_1",
          "default": false,
          "label": "Estilo de contorno"
        },
        {
          "type": "header",
          "content": "Botón 2"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "default": "Etiqueta de botón",
          "label": "Etiqueta",
          "info": "Dejar en blanco para ocultar"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Enlace"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_2",
          "default": false,
          "label": "Estilo de contorno"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner de imagen",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}
