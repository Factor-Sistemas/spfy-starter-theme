{% if page.content != blank or section.settings.show_heading %}
  <div class="section-padding-{{ section.id }} contenidos-estaticos">
    <div class="page__container ml-auto mr-auto full-width">
      <div class="mb-6 md:mb-8">
        <h1>Más de 50 años a tu lado</h1>
      </div>
      <p class="mb-4 ml-0">
        Pertenecemos a un importante grupo empresarial español (Grupo Club Internacional del Libro), con más de 50 años
        de experiencia, sede en Madrid y fuerte presencia internacional.
      </p>
      <p class="mb-4 ml-0">
        A lo largo de este tiempo, nuestro objetivo ha sido siempre el mismo: ofrecer los mejores productos, con las
        condiciones de adquisición más ventajosas y dar el mejor servicio a nuestros clientes.
      </p>
      <p class="mb-4 ml-0">
        Creaciones de Joyería y Relojería, propuestas para el hogar, lo último en Salud, Bienestar o Descanso... Mil y
        una ideas con un denominador común: el buen gusto, la exclusividad y la alta calidad, que nos han convertido en
        un verdadero símbolo de excelencia en nuestro país.
      </p>
      <p class="mb-4 ml-0">
        Porque tu satisfacción es nuestra razón de ser, contamos con un Servicio telefónico gratuito de Atención
        Personalizada que te ofrece el asesoramiento y trato profesional que te mereces en cada momento y resolverá
        cualquier duda que tengas.
      </p>
      <p class="mb-4 ml-0">
        Gracias por formar parte de nuestra historia. Tu confianza y apoyo nos inspiran a seguir mejorando cada día.
      </p>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.section-page.name",
  "tag": "section",
  "class": "section x-section x-section-page",
  "settings": [
    {
      "id": "show_heading",
      "type": "checkbox",
      "label": "t:sections.main-page.settings.show_heading.label",
      "info": "t:sections.main-page.settings.show_heading.info",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "t:sections.all.text.page_heading_size",
      "default": 170,
      "visible_if": "{{ section.settings.show_heading }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "default": "h1",
      "label": "t:sections.all.text.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "p"
        }
      ],
      "visible_if": "{{ section.settings.show_heading }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.breadcrumbs.label"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "default": true,
      "label": "t:settings_schema.search_navigation.show_breadcrumbs"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs_border",
      "default": false,
      "label": "t:settings_schema.search_navigation.show_breadcrumb_borders",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "checkbox",
      "id": "full_width_breadcrumb",
      "default": true,
      "label": "t:settings_schema.search_navigation.full_width",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "text-left",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "text-center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "text-right",
          "label": "t:sections.all.content_alignment.options__3.label"
        }
      ],
      "default": "text-left",
      "label": "t:sections.main-collection-banner.settings.desktop_content_alignment.label",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "text-left",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "text-center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "text-right",
          "label": "t:sections.all.content_alignment.options__3.label"
        }
      ],
      "default": "text-left",
      "label": "t:sections.main-collection-banner.settings.mobile_content_alignment.label",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "color",
      "id": "background_color_light",
      "default": "#f2f2f2",
      "label": "t:sections.all.background.background_color_light",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "color",
      "id": "text_color_light",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.text.color",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "color",
      "id": "textlink_color_light",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.main-collection-banner.block.textlink_color_light",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "color",
      "id": "background_color_dark",
      "default": "#313131",
      "label": "t:sections.all.background.background_color_dark",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "color",
      "id": "text_color_dark",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.text.color_dark",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "color",
      "id": "textlink_color_dark",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.main-collection-banner.block.textlink_color_dark",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "max_container_page_width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:settings_schema.layout.page_width",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_layout_mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ]
}
{% endschema %}
