<div class="bg-canvas text-body py-12 md:py-16 isolate">
  <div
    class="isolate max-w-[var(--page-width)] mx-auto px-4 md:px-20{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- unless section.settings.title == blank -%}
      <div class="text-center mb-8 md:mb-12">
        <h2 class="m-0 {% case section.settings.heading_size %}{% when 'h2' %}text-title-lg{% when 'h1' %}text-display-sm{% when 'h0' %}text-display-md{% when 'hxl' %}text-display-lg{% when 'hxxl' %}text-display-xl{% endcase %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}
    <div>
      <ul
        class="grid grid-cols-1 md:grid-cols-3 gap-8 m-0 p-0"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="col-span-1 list-none{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <div class="h-full bg-surface-card rounded-2xl border border-hairline p-6 transition-all hover:shadow-md">
              {%- if block.settings.image != blank -%}
                <div class="mb-4">
                  <div class="aspect-square overflow-hidden rounded-xl">
                    {% capture sizes %}
                      (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - 100px) / 3),
                      (min-width: 990px) calc((100vw - 100px) / 3),
                      (min-width: 750px) calc((100vw - 40px) / 2),
                      calc(100vw - 30px)
                    {% endcapture %}
                    {{
                      block.settings.image
                      | image_url: width: 3200
                      | image_tag:
                        widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                        sizes: sizes,
                        class: 'object-cover w-full h-full'
                    }}
                  </div>
                </div>
              {%- endif -%}
              <div>
                {%- if block.settings.title != blank -%}
                  <h3 class="text-xl font-semibold mb-2">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="text-muted mb-4">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <a
                    class="text-primary hover:underline font-medium inline-flex items-center gap-1 mt-4"
                    {% if block.settings.link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.link }}"
                    {% endif %}
                  >
                    {{- block.settings.link_label | escape -}}
                    <span class="flex items-center ml-2 whitespace-nowrap"></span>
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="text-center mt-8">
      {%- if section.settings.button_label != blank -%}
        <a
          class="inline-flex items-center justify-center px-5 py-3 h-11 min-w-[calc(12rem+2px)] no-underline cursor-pointer text-button font-button leading-none rounded-md bg-primary text-on-primary"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Multicolumna",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Varias columnas",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Pequeño"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        },
        {
          "value": "hxl",
          "label": "Extra grande"
        },
        {
          "value": "hxxl",
          "label": "Superextragrande"
        }
      ],
      "default": "h1",
      "label": "Tamaño del título"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Etiqueta de botón",
      "label": "Etiqueta",
      "info": "Dejar en blanco para ocultar"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Columna",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "Columna",
          "label": "Título"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Vincula un texto con una imagen para atraer la atención hacia tu producto, colección o artículo de blog seleccionados. Agrega detalles sobre disponibilidad y estilo, o incluso ofrece una reseña.</p>",
          "label": "Descripción"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Vincular etiqueta",
          "info": "Dejar en blanco para ocultar"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumna",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
