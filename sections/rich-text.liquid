<div class="isolate max-w-[var(--page-width)] mx-auto px-4 md:px-20">
  <div class="text-center bg-surface-card border border-hairline rounded-lg p-8 md:p-16">
    <div class="max-w-[50rem] lg:max-w-[78rem] mx-auto space-y-6 [&>*]:break-words">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2
              class="{% case block.settings.heading_size %}{% when 'h2' %}text-title-lg{% when 'h1' %}text-display-sm{% when 'h0' %}text-display-md{% when 'hxl' %}text-display-lg{% when 'hxxl' %}text-display-xl{% endcase %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {{ block.settings.heading }}
            </h2>
          {%- when 'caption' -%}
            <p
              class="{% case block.settings.text_style %}{% when 'subtitle' %}text-title-md{% when 'caption-with-letter-spacing' %}text-caption-uppercase{% endcase %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {{ block.settings.caption | escape }}
            </p>
          {%- when 'text' -%}
            <div
              class="text-body-md{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {{ block.settings.text }}
            </div>
          {%- when 'button' -%}
            <div
              class="inline-flex justify-center flex-wrap gap-4 w-full max-w-[45rem] break-words{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} [&>*]:grow [&>*]:min-w-[22rem]{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {%- if block.settings.button_label != blank -%}
                <a
                  {% if block.settings.button_link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link }}"
                  {% endif %}
                  class="inline-flex items-center justify-center px-5 py-3 h-11 min-w-[calc(12rem+2px)] no-underline cursor-pointer text-button font-button leading-none rounded-md{% if block.settings.button_style_secondary %} bg-canvas text-ink border border-hairline{% else %} bg-primary text-on-primary{% endif %}"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="inline-flex items-center justify-center px-5 py-3 h-11 min-w-[calc(12rem+2px)] no-underline cursor-pointer text-button font-button leading-none rounded-md{% if block.settings.button_style_secondary_2 %} bg-canvas text-ink border border-hairline{% else %} bg-primary text-on-primary{% endif %}"
                >
                  {{- block.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Texto enriquecido",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "limit": 3,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Coméntanos sobre tu marca",
          "label": "Título"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "Pequeño"
            },
            {
              "value": "h1",
              "label": "Mediano"
            },
            {
              "value": "h0",
              "label": "Grande"
            },
            {
              "value": "hxl",
              "label": "Extra grande"
            },
            {
              "value": "hxxl",
              "label": "Superextragrande"
            }
          ],
          "default": "h1",
          "label": "Tamaño del título"
        }
      ]
    },
    {
      "type": "caption",
      "name": "Leyenda",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "default": "Agregar un eslogan",
          "label": "Texto"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "subtitle",
              "label": "Subtítulo"
            },
            {
              "value": "caption-with-letter-spacing",
              "label": "Mayúscula"
            }
          ],
          "default": "caption-with-letter-spacing",
          "label": "Estilo"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            {
              "value": "small",
              "label": "Pequeño"
            },
            {
              "value": "medium",
              "label": "Mediano"
            },
            {
              "value": "large",
              "label": "Grande"
            }
          ],
          "default": "medium",
          "label": "Talla"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "limit": 3,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Comparte información sobre tu marca con los clientes. Describe un producto, comparte anuncios o da la bienvenida a los clientes a tu tienda.</p>",
          "label": "Texto"
        }
      ]
    },
    {
      "type": "button",
      "name": "Botones",
      "limit": 2,
      "settings": [
        {
         "type": "header",
         "content": "Botón 1"
        },        
        {
          "type": "text",
          "id": "button_label",
          "default": "Etiqueta de botón",
          "label": "Etiqueta",
          "info": "Dejar en blanco para ocultar"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "default": false,
          "label": "Estilo de contorno"
        },
        {
         "type": "header",
         "content": "Botón 2"
        },          
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Etiqueta",
          "info": "Deja la etiqueta en blanco para ocultar"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Enlace"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_2",
          "default": false,
          "label": "Estilo de contorno"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Texto enriquecido",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
