<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding text-gray-900"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>
  <!-- BANNER SUPERIOR DE CONFIANZA -->
  {% render 'fs-product-trust-banner' %}

  <!-- HERO PRINCIPAL DE PRODUCTO -->
  <div class="container-detalle sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- COLUMNA IZQUIERDA: GALERÍA DE IMÁGENES CON SWIPER -->
      <div class="lg:col-span-7">
        {% render 'fs-product-gallery' %}
      </div>

      <!-- COLUMNA DERECHA: INFORMACIÓN Y ACCIONES DE COMPRA -->
      <div class="lg:col-span-5 w-full">
        {% render 'fs-product-buy-area', product: product, section: section %}
      </div>
    </div>

    <!-- SECCIÓN DE HISTORIA Y ESPECIFICACIONES TÉCNICAS -->
    {% render 'fs-product-story-specs', product: product %}
    {% render 'fs-imagenes-textos', product: product %}
  </div>
</product-info>

{% schema %}
{
  "name": "Información de producto",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Bloque de texto",
          "label": "Texto"
        }
      ]
    },
    {
      "type": "title",
      "name": "Título",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Precio",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Selector de variante",
      "limit": 1
    },
    {
      "type": "quantity_selector",
      "name": "Selector de cantidad",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Botones de compra",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Descripción",
      "limit": 1
    },
    {
      "type": "share",
      "name": "Compartir",
      "limit": 1
    },
    {
      "type": "sku",
      "name": "SKU",
      "limit": 1
    },
    {
      "type": "inventory",
      "name": "Inventario",
      "limit": 1
    },
    {
      "type": "custom_liquid",
      "name": "Liquid personalizado"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "default": true,
      "label": "Contenido fijo"
    }
  ]
}
{% endschema %}
