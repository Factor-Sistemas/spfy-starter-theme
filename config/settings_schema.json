[
  {
    "name": "theme_info",
    "theme_name": "spy FS starter theme",
    "theme_version": "15.4.1",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Google Tag Manager",
    "settings": [
      {
        "type": "text",
        "id": "google_analytics_id",
        "label": "Id Google Tag Manager",
        "placeholder": "GTM-XXXXXXXXx",
        "info": "Introduce tu ID de google tag manager"
      }
    ]
  },
  {
    "name": "Sticky Header",
    "settings": [
      {
        "type": "header",
        "content": "Logo"
      },
      {
        "type": "image_picker",
        "id": "sticky_header_logo",
        "label": "Logo Sticky Header"
      },
      {
        "type": "header",
        "content": "Dimensiones"
      },
      {
        "type": "select",
        "id": "sticky_header_height",
        "label": "Altura",
        "options": [
          { "value": "h-24", "label": "Pequeña (96px)" },
          { "value": "h-28", "label": "Mediana (112px)" },
          { "value": "h-32", "label": "Grande (128px)" },
          { "value": "h-36", "label": "Extra Grande (144px)" }
        ],
        "default": "h-24"
      },
      {
        "type": "header",
        "content": "Alineación"
      },
      {
        "type": "select",
        "id": "sticky_header_align_mobile",
        "label": "Móvil",
        "options": [
          { "value": "justify-center", "label": "Centrado" },
          { "value": "justify-start", "label": "Izquierda" }
        ],
        "default": "justify-center"
      },
      {
        "type": "select",
        "id": "sticky_header_align_desktop",
        "label": "Escritorio",
        "options": [
          { "value": "md:justify-center", "label": "Centrado" },
          { "value": "md:justify-start", "label": "Izquierda" }
        ],
        "default": "md:justify-start"
      }
    ]
  },
  {
    "name": "Contenidos Footer",
    "settings": [
      {
        "type": "header",
        "content": "Copyright"
      },
      {
        "type": "text",
        "id": "frase_copyright",
        "label": "Texto Copyright"
      },
      {
        "type": "header",
        "content": "Pagos"
      },
      {
        "type": "text",
        "id": "frase_forma_pago",
        "label": "Texto formas de pago"
      },
      {
        "type": "header",
        "content": "Marca"
      },
      {
        "type": "image_picker",
        "id": "footer_logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "footer_logo_width",
        "min": 50,
        "max": 300,
        "step": 5,
        "unit": "px",
        "default": 120,
        "label": "Ancho logo"
      },
      {
        "type": "textarea",
        "id": "footer_brand_description",
        "label": "Descripción"
      },
      {
        "type": "header",
        "content": "Email"
      },
      {
        "type": "textarea",
        "id": "footer_email_svg",
        "label": "Código SVG",
        "info": "Pega aquí el código <svg>...</svg>"
      },
      {
        "type": "text",
        "id": "footer_email_title",
        "label": "Título"
      },
      {
        "type": "text",
        "id": "footer_email_link",
        "label": "Email / Enlace"
      },
      {
        "type": "header",
        "content": "Teléfono"
      },
      {
        "type": "textarea",
        "id": "footer_phone_svg",
        "label": "Código SVG",
        "info": "Pega aquí el código <svg>...</svg>"
      },
      {
        "type": "text",
        "id": "footer_phone_title",
        "label": "Título"
      },
      {
        "type": "text",
        "id": "footer_phone_link",
        "label": "Teléfono / Enlace"
      },
      {
        "type": "header",
        "content": "Horario"
      },
      {
        "type": "textarea",
        "id": "footer_schedule_svg",
        "label": "Código SVG",
        "info": "Pega aquí el código <svg>...</svg>"
      },
      {
        "type": "text",
        "id": "footer_schedule_title",
        "label": "Título"
      },
      {
        "type": "text",
        "id": "footer_schedule_text",
        "label": "Texto Horario"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 100,
        "unit": "px",
        "label": "Ancho"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Se muestra en 32 x 32 px"
      }
    ]
  },
  {
    "name": "Información de marca",
    "settings": [
      {
        "type": "paragraph",
        "content": "Se muestra en el bloque de información de marca del pie de página"
      },
      {
        "type": "inline_richtext",
        "id": "brand_headline",
        "label": "Titular"
      },
      {
        "type": "richtext",
        "id": "brand_description",
        "label": "Descripción"
      },
      {
        "type": "image_picker",
        "id": "brand_image",
        "label": "Imagen"
      },
      {
        "type": "range",
        "id": "brand_image_width",
        "min": 50,
        "max": 550,
        "step": 5,
        "default": 100,
        "unit": "px",
        "label": "Ancho de imagen"
      }
    ]
  },
  {
    "name": "Redes sociales",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "placeholder": "https://www.facebook.com/ShopifyES/"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "placeholder": "http://instagram.com/shopify"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "placeholder": "https://www.youtube.com/shopify"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "placeholder": "https://tiktok.com/@shopify"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X / Twitter",
        "placeholder": "https://x.com/shopify"
      },
      {
        "type": "text",
        "id": "social_snapchat_link",
        "label": "Snapchat",
        "placeholder": "https://www.snapchat.com/add/shopify"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "placeholder": "https://pinterest.com/shopify"
      },
      {
        "type": "text",
        "id": "social_tumblr_link",
        "label": "Tumblr",
        "placeholder": "https://shopify.tumblr.com"
      },
      {
        "type": "text",
        "id": "social_vimeo_link",
        "label": "Vimeo",
        "placeholder": "https://vimeo.com/shopify"
      }
    ]
  },
  {
    "name": "Comportamiento de búsqueda",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "default": true,
        "label": "Sugerencias de búsqueda"
      },
      {
        "type": "checkbox",
        "id": "predictive_search_show_vendor",
        "default": false,
        "label": "Proveedor de producto",
        "info": "Se muestra cuando las sugerencias de búsqueda están activadas"
      },
      {
        "type": "checkbox",
        "id": "predictive_search_show_price",
        "default": false,
        "label": "Precio del producto",
        "info": "Se muestra cuando las sugerencias de búsqueda están activadas"
      }
    ]
  },
  {
    "name": "Formato de moneda",
    "settings": [
      {
        "type": "paragraph",
        "content": "Los precios en el carrito y la página de pago siempre muestran códigos de moneda"
      },
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Códigos de moneda",
        "default": true
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "header",
        "content": "Encabezados"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "outfit_n5",
        "label": "Fuente de encabezados"
      },
      {
        "type": "range",
        "id": "heading_base_size",
        "min": 50,
        "max": 200,
        "step": 10,
        "unit": "%",
        "label": "Tamaño base de encabezados",
        "default": 100
      },
      {
        "type": "header",
        "content": "Cuerpo"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "jost_n4",
        "label": "Fuente del cuerpo"
      },
      {
        "type": "range",
        "id": "text_base_size",
        "min": 50,
        "max": 200,
        "step": 10,
        "unit": "%",
        "label": "Tamaño base del texto",
        "default": 100
      },
      {
        "type": "header",
        "content": "Otros"
      },
      {
        "type": "font_picker",
        "id": "type_menu_font",
        "default": "jost_n5",
        "label": "Fuente del menú"
      },
      {
        "type": "font_picker",
        "id": "type_button_font",
        "default": "jost_n6",
        "label": "Fuente de botones"
      },
      {
        "type": "font_picker",
        "id": "heading_highlight_font",
        "default": "outfit_n6",
        "label": "Fuente de textos destacados"
      }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Proveedor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "comprar_ya_disponible",
        "label": "Comprar ya disponible",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "aniadir_carro_en_coleccion",
        "label": "Mostrar compra en colección",
        "default": true
      }
    ]
  }
]
