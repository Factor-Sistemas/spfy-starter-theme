[
  {
    "name": "theme_info",
    "theme_name": "spy FS starter theme",
    "theme_version": "15.4.1",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 100,
        "unit": "px",
        "label": "Ancho"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Se muestra en 32 x 32 px"
      }
    ]
  },
  {
    "name": "Información de marca",
    "settings": [
      {
        "type": "paragraph",
        "content": "Se muestra en el bloque de información de marca del pie de página"
      },
      {
        "type": "inline_richtext",
        "id": "brand_headline",
        "label": "Titular"
      },
      {
        "type": "richtext",
        "id": "brand_description",
        "label": "Descripción"
      },
      {
        "type": "image_picker",
        "id": "brand_image",
        "label": "Imagen"
      },
      {
        "type": "range",
        "id": "brand_image_width",
        "min": 50,
        "max": 550,
        "step": 5,
        "default": 100,
        "unit": "px",
        "label": "Ancho de imagen"
      }
    ]
  },
  {
    "name": "Redes sociales",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "placeholder": "https://www.facebook.com/ShopifyES/"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "placeholder": "http://instagram.com/shopify"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "placeholder": "https://www.youtube.com/shopify"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "placeholder": "https://tiktok.com/@shopify"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X / Twitter",
        "placeholder": "https://x.com/shopify"
      },
      {
        "type": "text",
        "id": "social_snapchat_link",
        "label": "Snapchat",
        "placeholder": "https://www.snapchat.com/add/shopify"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "placeholder": "https://pinterest.com/shopify"
      },
      {
        "type": "text",
        "id": "social_tumblr_link",
        "label": "Tumblr",
        "placeholder": "https://shopify.tumblr.com"
      },
      {
        "type": "text",
        "id": "social_vimeo_link",
        "label": "Vimeo",
        "placeholder": "https://vimeo.com/shopify"
      }
    ]
  },
  {
    "name": "Comportamiento de búsqueda",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "default": true,
        "label": "Sugerencias de búsqueda"
      },
      {
        "type": "checkbox",
        "id": "predictive_search_show_vendor",
        "default": false,
        "label": "Proveedor de producto",
        "info": "Se muestra cuando las sugerencias de búsqueda están activadas"
      },
      {
        "type": "checkbox",
        "id": "predictive_search_show_price",
        "default": false,
        "label": "Precio del producto",
        "info": "Se muestra cuando las sugerencias de búsqueda están activadas"
      }
    ]
  },
  {
    "name": "Formato de moneda",
    "settings": [
      {
        "type": "paragraph",
        "content": "Los precios en el carrito y la página de pago siempre muestran códigos de moneda"
      },
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Códigos de moneda",
        "default": true
      }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "Lateral"
          },
          {
            "value": "page",
            "label": "Página"
          },
          {
            "value": "notification",
            "label": "Notificación emergente"
          }
        ],
        "default": "notification",
        "label": "Tipo"
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Proveedor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Nota del carrito",
        "default": false
      },
      {
        "type": "header",
        "content": "Carrito lateral"
      },
      {
        "type": "collection",
        "id": "cart_drawer_collection",
        "label": "Colección",
        "info": "Se muestra cuando el carrito lateral está vacío"
      },
      {
        "type": "color_scheme",
        "id": "cart_color_scheme",
        "label": "Esquema de colores",
        "default": "scheme-1"
      }
    ]
  }
]
