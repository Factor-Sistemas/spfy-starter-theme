[
  {
    "name": "theme_info",
    "theme_name": "Dawn",
    "theme_version": "15.4.1",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 100,
        "unit": "px",
        "label": "Ancho"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Se muestra en 32 x 32 px"
      }
    ]
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Fondo",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Degradado de fondo",
            "info": "El degradado de fondo reemplaza el fondo donde es posible."
          },
          {
            "type": "color",
            "id": "text",
            "label": "Texto",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Fondo de botón sólido",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Etiqueta de botón sólido",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Botón de contorno",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "Sombra",
            "default": "#121212"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "header",
        "content": "Títulos"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "assistant_n4",
        "label": "Fuente"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 100,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Escala",
        "default": 100
      },
      {
        "type": "header",
        "content": "Cuerpo"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "Fuente"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 100,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Escala",
        "default": 100
      }
    ]
  },
  {
    "name": "Diseño",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 100,
        "default": 1200,
        "unit": "px",
        "label": "Ancho de página"
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Espacio entre las secciones de la plantilla",
        "default": 0
      },
      {
        "type": "header",
        "content": "Cuadrícula"
      },
      {
        "type": "paragraph",
        "content": "Afecta a áreas con varias columnas o filas"
      },
      {
        "type": "range",
        "id": "spacing_grid_horizontal",
        "min": 4,
        "max": 40,
        "step": 4,
        "default": 8,
        "unit": "px",
        "label": "Espacio horizontal"
      },
      {
        "type": "range",
        "id": "spacing_grid_vertical",
        "min": 4,
        "max": 40,
        "step": 4,
        "default": 8,
        "unit": "px",
        "label": "Espacio vertical"
      }
    ]
  },
  {
    "name": "Animaciones",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_reveal_on_scroll",
        "label": "Revelar secciones al desplazarse",
        "default": true
      },
      {
        "type": "select",
        "id": "animations_hover_elements",
        "options": [
          {
            "value": "default",
            "label": "Ninguna"
          },
          {
            "value": "vertical-lift",
            "label": "Elevación vertical"
          },
          {
            "value": "3d-lift",
            "label": "Elevación 3D"
          }
        ],
        "default": "default",
        "label": "Efecto hover",
        "info": "Afecta a tarjetas y botones"
      }
    ]
  },
